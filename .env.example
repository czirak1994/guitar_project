# Copy this file to .env and fill in real values. Nothing here is a secret —
# these are just the variable names the app reads (see config.py, auth.py,
# payments.py, analytics.py, api/server.py).

# ── Database ──────────────────────────────────────────────────────────────
# Leave unset for local dev (falls back to sqlite:///app.db).
DATABASE_URL=

# ── Clerk (authentication) ───────────────────────────────────────────────
CLERK_SECRET_KEY=
# Frontend build-time key — read by Vite, must start with VITE_.
VITE_CLERK_PUBLISHABLE_KEY=

# ── Stripe (billing) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Public base URL of the deployed frontend, used to build Stripe redirect
# and billing-portal return URLs. Example: https://tonesense.app
FRONTEND_URL=

# ── Gemini (AI coaching) ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── PostHog (analytics) ───────────────────────────────────────────────────
# Backend (server-side events, e.g. the Stripe webhook).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Frontend build-time keys — read by Vite, must start with VITE_. Can be the
# same project key as POSTHOG_API_KEY above.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Storage ───────────────────────────────────────────────────────────────
# Where uploaded recordings are persisted. Defaults to ./uploads — point this
# at a mounted volume in production, or the files vanish on every deploy.
UPLOADS_DIR=
